<launch>
    <let name="urdf_path" 
         value="$(find-pkg-share vgr_sim)/urdf/robot.urdf.xacro" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
               value="$(command 'ros2 run xacro xacro $(var urdf_path)')" />
    </node>
</launch>