<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <link name="lidar_tower_link">
        <visual>
            <geometry>
                <box size="0.07 0.085 0.06" /> </geometry>
            <material name="dark_grey">
                <color rgba="0.2 0.2 0.2 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.07 0.085 0.06" />
            </geometry>
        </collision>
    </link>

    <joint name="tower_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_tower_link" />
        <origin xyz="-0.0025 0.0 0.064" rpy="0 0 0" /> 
    </joint>

    <joint name="laser_joint" type="fixed">
        <parent link="lidar_tower_link"/>
        <child link="laser_frame"/>
        <origin xyz="0 0 0.039" rpy="0 0 0"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.025" length="0.018"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="0 0 -0.05"/>
            <geometry>
                <cylinder radius="0.025" length="0.018"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.025" length="0.018"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.1" r="0.018" h="0.025" xyz="0 0 0" rpy="0 0 0" >
        </xacro:cylinder_inertia>
    </link>



